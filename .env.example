# API (local Compose / npm run dev)
PORT=8787
MAX_FILE_SIZE_MB=80
TEMP_TTL_SECONDS=3600
CONVERTER_URL=http://localhost:8090

# Abuse protection (GuardPlugins) — local uses in-memory counters
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SEC=60
MAX_CONCURRENT_PER_IP=2
MAX_CONCURRENT_GLOBAL=5

# Optional private mode: if set, require X-Access-Token header or ?token=
# ACCESS_TOKEN=do-not-commit-real-secrets

# Cloudflare production uses the CALIBRE_CONVERTER container binding
# (see wrangler.toml). CONVERTER_URL is optional fallback only:
# CONVERTER_URL=https://your-calibre-sidecar.example.com
#
# Production rate limits need a KV namespace bound as RATE_LIMIT (see README).
# Set ACCESS_TOKEN via: npx wrangler secret put ACCESS_TOKEN
